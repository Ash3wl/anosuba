{"id":2,"name":"EV002","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"People4","direction":2,"pattern":1,"characterIndex":3},"list":[{"code":213,"indent":0,"parameters":[0,3,true]},{"code":101,"indent":0,"parameters":["Kaya[BUST]",0,0,2]},{"code":401,"indent":0,"parameters":["Elf\\bust[8]\\bustDim[2]\\bustLight[8]"]},{"code":401,"indent":0,"parameters":["\"Welcome back, human Masters.\""]},{"code":101,"indent":0,"parameters":["[BUST]Vazuma_7",1,0,2]},{"code":401,"indent":0,"parameters":["Vazuma\\bust[2]\\bustDim[8]\\bustLight[2]"]},{"code":401,"indent":0,"parameters":["\"M-m-m-masters...? Uh... Ehehe... H-hi...\""]},{"code":101,"indent":0,"parameters":["[BUST]Matness_5",1,0,2]},{"code":401,"indent":0,"parameters":["Matness\\bust[2]\\bustDim[8]"]},{"code":401,"indent":0,"parameters":["\"Stop being awkward with the elf lady, you're making"]},{"code":401,"indent":0,"parameters":["her uncomfortable.\""]},{"code":101,"indent":0,"parameters":["[BUST]Matness_1",1,0,2]},{"code":401,"indent":0,"parameters":["Matness\\bust[2]\\bustDim[8]\\bustLight[2]"]},{"code":401,"indent":0,"parameters":["\"Excuse us. We're here to help with the quest you posted"]},{"code":401,"indent":0,"parameters":["at the Adventurer's Guild.\""]},{"code":205,"indent":0,"parameters":[0,{"list":[{"code":4,"indent":null},{"code":3,"indent":null},{"code":4,"indent":null},{"code":0}],"repeat":false,"skippable":true,"wait":false}]},{"code":505,"indent":0,"parameters":[{"code":4,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":3,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":4,"indent":null}]},{"code":101,"indent":0,"parameters":["Kaya[BUST]",0,0,2]},{"code":401,"indent":0,"parameters":["Elf\\bust[8]\\bustDim[2]\\bustLight[8]"]},{"code":401,"indent":0,"parameters":["\"Ah, yes... I need a rare herb found within this"]},{"code":401,"indent":0,"parameters":["dungeon, hidden betwixt the trees.\""]},{"code":101,"indent":0,"parameters":["Kaya[BUST]",0,0,2]},{"code":401,"indent":0,"parameters":["Elf\\bust[8]\\bustDim[2]"]},{"code":401,"indent":0,"parameters":["\"Unfortunately, the interior is labyrinthine, and full"]},{"code":401,"indent":0,"parameters":["of dangerous monsters. Even the bravest adventurers"]},{"code":401,"indent":0,"parameters":["ill-desire such a place to meet their end.\""]},{"code":101,"indent":0,"parameters":["[BUST]Vazuma_10",1,0,2]},{"code":401,"indent":0,"parameters":["Vazuma\\bust[2]\\bustDim[8]\\bustLight[2]"]},{"code":401,"indent":0,"parameters":["\"Well, you, uh... You can count on us!\""]},{"code":205,"indent":0,"parameters":[0,{"list":[{"code":16,"indent":null},{"code":0}],"repeat":false,"skippable":false,"wait":true}]},{"code":505,"indent":0,"parameters":[{"code":16,"indent":null}]},{"code":213,"indent":0,"parameters":[0,8,true]},{"code":213,"indent":0,"parameters":[0,2,true]},{"code":205,"indent":0,"parameters":[0,{"list":[{"code":1,"indent":null},{"code":2,"indent":null},{"code":1,"indent":null},{"code":25,"indent":null},{"code":0}],"repeat":false,"skippable":true,"wait":true}]},{"code":505,"indent":0,"parameters":[{"code":1,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":2,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":1,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":25,"indent":null}]},{"code":101,"indent":0,"parameters":["Kaya[BUST]",0,0,2]},{"code":401,"indent":0,"parameters":["Elf\\bust[8]\\bustDim[2]\\bustLight[8]"]},{"code":401,"indent":0,"parameters":["\"I'm sorry, but... Are there only three of you?\""]},{"code":101,"indent":0,"parameters":["Kaya[BUST]",0,0,2]},{"code":401,"indent":0,"parameters":["Elf\\bust[8]\\bustDim[2]"]},{"code":401,"indent":0,"parameters":["\"I'm afraid I cannot in good conscience allow you to"]},{"code":401,"indent":0,"parameters":["enter with such a small group.\""]},{"code":101,"indent":0,"parameters":["[BUST]Vazuma_2",1,0,2]},{"code":401,"indent":0,"parameters":["Vazuma\\bust[2]\\bustDim[8]\\bustLight[2]"]},{"code":401,"indent":0,"parameters":["\"Huh?\""]},{"code":101,"indent":0,"parameters":["[BUST]Matness_15",1,0,2]},{"code":401,"indent":0,"parameters":["Matness\\bust[2]\\bustDim[8]\\bustLight[2]"]},{"code":401,"indent":0,"parameters":["\"There may only be three of us, but you will not find"]},{"code":401,"indent":0,"parameters":["us lacking in strength.\""]},{"code":101,"indent":0,"parameters":["Kaya[BUST]",0,0,2]},{"code":401,"indent":0,"parameters":["Elf\\bust[8]\\bustDim[2]\\bustLight[8]"]},{"code":401,"indent":0,"parameters":["\"Do not doubt my words, human. Looking at you..."]},{"code":401,"indent":0,"parameters":["You most of all, should not be making such claims.\""]},{"code":101,"indent":0,"parameters":["[BUST]Matness_13",1,0,2]},{"code":401,"indent":0,"parameters":["Matness\\bust[2]\\bustDim[8]\\bustLight[2]"]},{"code":401,"indent":0,"parameters":["\"Er, I meant--in general--\""]},{"code":101,"indent":0,"parameters":["Kaya[BUST]",0,0,2]},{"code":401,"indent":0,"parameters":["Elf\\bust[8]\\bustDim[2]\\bustLight[8]"]},{"code":401,"indent":0,"parameters":["\"In fact, I've seen heartier stalks on river ferns."]},{"code":401,"indent":0,"parameters":["Those 'arms' of yours seem so weak, could you even"]},{"code":401,"indent":0,"parameters":["lift a bundle of ferns with them?\""]},{"code":101,"indent":0,"parameters":["[BUST]Matness_17",1,0,2]},{"code":401,"indent":0,"parameters":["Matness\\bust[2]\\bustDim[8]\\bustLight[2]"]},{"code":401,"indent":0,"parameters":["\"Th-that...might be true...\""]},{"code":101,"indent":0,"parameters":["Kaya[BUST]",0,0,2]},{"code":401,"indent":0,"parameters":["Elf\\bust[8]\\bustDim[2]\\bustLight[8]"]},{"code":401,"indent":0,"parameters":["<Insert more dialogue that Char is too much of a"]},{"code":401,"indent":0,"parameters":["bottom to come up with>"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["anyway"]},{"code":101,"indent":0,"parameters":["[BUST]Vazuma_6",1,0,2]},{"code":401,"indent":0,"parameters":["Vazuma\\bust[2]\\bustDim[8]\\bustLight[2]"]},{"code":401,"indent":0,"parameters":["\"Is there... Really no way you'll let us in?"]},{"code":401,"indent":0,"parameters":["We are just trying to help you out.\""]},{"code":101,"indent":0,"parameters":["Kaya[BUST]",0,0,2]},{"code":401,"indent":0,"parameters":["Elf\\bust[8]\\bustDim[2]"]},{"code":401,"indent":0,"parameters":["\"Hm...\""]},{"code":101,"indent":0,"parameters":["Kaya[BUST]",0,0,2]},{"code":401,"indent":0,"parameters":["Elf\\bust[8]\\bustDim[2]\\bustLight[8]"]},{"code":401,"indent":0,"parameters":["\"If you wish to prove yourselves, I would have you"]},{"code":401,"indent":0,"parameters":["collect three items, and bring them to me:\""]},{"code":101,"indent":0,"parameters":["Kaya[BUST]",0,0,2]},{"code":401,"indent":0,"parameters":["Elf\\bust[8]\\bustDim[2]"]},{"code":401,"indent":0,"parameters":["\"The tears of an incel, a wonderful fish, and an item"]},{"code":401,"indent":0,"parameters":["made with materials not from this world.\""]},{"code":101,"indent":0,"parameters":["[BUST]Vazuma_5",1,0,2]},{"code":401,"indent":0,"parameters":["Vazuma\\bust[2]\\bustDim[8]\\bustLight[2]"]},{"code":401,"indent":0,"parameters":["\"That's... Q-quite the specific list.\""]},{"code":101,"indent":0,"parameters":["Kaya[BUST]",0,0,2]},{"code":401,"indent":0,"parameters":["Elf\\bust[8]\\bustDim[2]\\bustLight[8]"]},{"code":401,"indent":0,"parameters":["\"Either bring me those items, or come back with"]},{"code":401,"indent":0,"parameters":["at least a party of four. Then, I will deem you"]},{"code":401,"indent":0,"parameters":["ready to explore the dungeon.\""]},{"code":101,"indent":0,"parameters":["[BUST]Vazuma_13",1,0,2]},{"code":401,"indent":0,"parameters":["Vazuma\\bust[2]\\bustDim[8]\\bustLight[2]"]},{"code":401,"indent":0,"parameters":["\"Well, we'll do it!\""]},{"code":101,"indent":0,"parameters":["[BUST]Matness_6",1,0,2]},{"code":401,"indent":0,"parameters":["Matness\\bust[2]\\bustDim[8]\\bustLight[2]"]},{"code":401,"indent":0,"parameters":["\"W-we will....find you those items.\""]},{"code":101,"indent":0,"parameters":["[BUST]Chargumin_1",1,0,2]},{"code":401,"indent":0,"parameters":["Chargumin\\bust[2]\\bustDim[8]\\bustLight[2]"]},{"code":401,"indent":0,"parameters":["\"Mhm. Yeah.\""]},{"code":205,"indent":0,"parameters":[4,{"list":[{"code":14,"parameters":[0,0],"indent":null},{"code":14,"parameters":[0,0],"indent":null},{"code":0}],"repeat":false,"skippable":false,"wait":false}]},{"code":505,"indent":0,"parameters":[{"code":14,"parameters":[0,0],"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":14,"parameters":[0,0],"indent":null}]},{"code":101,"indent":0,"parameters":["Timusuke[BUST]",1,0,2]},{"code":401,"indent":0,"parameters":["Timusuke\\bust[2]\\bustDim[8]\\bustLight[2]"]},{"code":401,"indent":0,"parameters":["\"Meow.\""]},{"code":205,"indent":0,"parameters":[-1,{"list":[{"code":16,"indent":null},{"code":0}],"repeat":false,"skippable":false,"wait":true}]},{"code":505,"indent":0,"parameters":[{"code":16,"indent":null}]},{"code":101,"indent":0,"parameters":["[BUST]Vazuma_15",1,0,2]},{"code":401,"indent":0,"parameters":["Vazuma\\bust[2]\\bustDim[8]\\bustLight[2]"]},{"code":401,"indent":0,"parameters":["\"Did...anyone else hear a cat just now?\""]},{"code":101,"indent":0,"parameters":["[BUST]Matness_1",1,0,2]},{"code":401,"indent":0,"parameters":["Matness\\bust[2]\\bustDim[8]\\bustLight[2]"]},{"code":401,"indent":0,"parameters":["\"Yes? Why?\""]},{"code":101,"indent":0,"parameters":["[BUST]Vazuma_12",1,0,2]},{"code":401,"indent":0,"parameters":["Matness\\bust[2]\\bustDim[8]\\bustLight[2]"]},{"code":401,"indent":0,"parameters":["\"Do you think maybe he will be our fourth party"]},{"code":401,"indent":0,"parameters":["memb